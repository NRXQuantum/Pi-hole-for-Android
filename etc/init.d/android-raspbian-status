#!/bin/bash
### BEGIN INIT INFO
# Provides: android-raspbian-status
# Required-Start: $all
# Required-Stop: $local_fs $network $time $remote_fs $syslog avahi-daemon
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Daemon status at boot/shutdown
# Description: Raspbian for Android Status
### END INIT INFO

case "$1" in
start)

echo
echo '_______________________________________________'
neofetch --disable title --ascii_distro Raspbian | sed -r 's/\x1b\[[^@-~]*[@-~]//g'  > /tmp/neo
yes ' ' | sed 60q
cat /tmp/neo | sed -e 's/^/  /' | grep -v Shell | grep -v Terminal | head -n -14 ; sleep 2
echo '_______________________________________________'
echo '                                               '
   [[ -f /usr/local/bin/pihole ]] && pihole -v
   if [ -f /var/tmp/p4a ] ; then
      P4A=`cat /var/tmp/p4a`
      rm /var/tmp/p4a
      echo " "
      echo " IMPORTANT: RDP/SSH/Pi-hole admin password is"
      echo "            shown below ONCE, record it now!"
      echo " "
      echo "  --> $P4A <--"
      P4A="NOPE"
    else
     echo " "
     [[ -f /usr/local/bin/pihole ]] && pihole status
  fi
echo '_______________________________________________'
echo
# Publish mDNS aliases only when a working avahi daemon is available.
# The old code called avahi-resolve unconditionally, which printed
# "Failed to create client object: Daemon not running" on every boot.
IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
[ -z "$IP" ] && IP=$(hostname -I 2>/dev/null | awk '{print $1}')
if [ -n "$IP" ] && /usr/sbin/avahi-daemon -c >/dev/null 2>&1; then
   HOST=$(hostname)
   # avahi-daemon.conf sets host-name=pihole, so pihole.local is automatic
   [ "$HOST" != "pihole" ] && (avahi-publish -a -R "$HOST.local" "$IP" >/dev/null 2>&1 &)
   (avahi-publish -a -R nextcloudpi.local "$IP" >/dev/null 2>&1 &)
fi
;;

stop)

yes ' ' | sed 60q
echo '_______________________________________________'
echo '                                               '
echo '     *** Container SHUTDOWN Initiated! ***     '
echo '_______________________________________________'
yes ' ' | sed 2q
;;

*)
echo "Usage: $0 {start|stop}"
exit 1
esac
exit 0
