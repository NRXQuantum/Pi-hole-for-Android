#!/bin/sh
### BEGIN INIT INFO
# Provides:          p4a-terminal
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Loopback telnetd for the Pi Deploy web terminal
# Description:       Pi Deploy's web console connects to 127.0.0.1:5023
#                    via telnet.  Historically that was provided by the
#                    Android-side busybox telnetd, which is disabled by
#                    default.  This service provides the same endpoint
#                    inside the container so the web terminal works with
#                    any Pi Deploy build.  It listens on loopback only.
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin
NAME=p4a-terminal
DAEMON=/bin/busybox
HELPER=/usr/local/bin/p4a-terminald
PIDFILE=/run/p4a-terminal.pid
PORT=5023
ADDR=127.0.0.1

cd /

port_in_use() {
        # Prefer ss, fall back to busybox netstat.
        if command -v ss >/dev/null 2>&1; then
                ss -ltn 2>/dev/null | grep -q "${ADDR}:${PORT} "
        else
                $DAEMON netstat -ltn 2>/dev/null | grep -q "${ADDR}:${PORT} "
        fi
}

is_running() {
        [ -s "$PIDFILE" ] || return 1
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
  start)
        [ -x "$DAEMON" ] || exit 0
        # If the Android-side telnetd (or another service) already owns the
        # port, leave it alone - the web terminal will use that one.
        port_in_use && exit 0
        is_running && exit 0
        rm -f "$PIDFILE"
        # Detach from the init script; busybox telnetd then runs in the
        # foreground under the wrapper, which records its pid.
        setsid "$HELPER" >/dev/null 2>&1 &
        ;;
  stop)
        if [ -s "$PIDFILE" ]; then
                pid=$(cat "$PIDFILE" 2>/dev/null)
                if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                        kill "$pid" 2>/dev/null
                        sleep 1
                        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
                fi
        fi
        rm -f "$PIDFILE"
        ;;
  restart|force-reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
  status)
        if is_running || port_in_use; then
                echo "$NAME is running"
                exit 0
        fi
        echo "$NAME is not running"
        exit 3
        ;;
  *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac

exit 0
